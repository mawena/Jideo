# Adresse d'écoute sur la machine hôte. 127.0.0.1 = accès local uniquement.
# Toute autre valeur (ex. 0.0.0.0) exige JIDEO_PASSWORD.
JIDEO_BIND=127.0.0.1
JIDEO_PORT=4545
JIDEO_PASSWORD=
# Généré par ./jideo install
JIDEO_SECRET=
JIDEO_MAX_PHOTO_MB=25
JIDEO_MAX_VIDEO_MB=1024
JIDEO_MAX_VIDEO_SECONDS=300
JIDEO_RETENTION_DAYS=30
# Propriétaire des fichiers de data/ (renseigné par ./jideo install)
JIDEO_UID=1000
JIDEO_GID=1000
