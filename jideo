#!/usr/bin/env bash
# Façade de Jideo — ./jideo help
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"

compose() { docker compose "$@"; }
die() { echo "✗ $*" >&2; exit 1; }

ensure_env() {
  if [[ ! -f .env ]]; then
    cp .env.example .env
    local secret
    secret=$(python3 -c 'import secrets; print(secrets.token_hex(32))' 2>/dev/null || openssl rand -hex 32)
    sed -i "s/^JIDEO_SECRET=.*/JIDEO_SECRET=${secret}/" .env
    sed -i "s/^JIDEO_UID=.*/JIDEO_UID=$(id -u)/; s/^JIDEO_GID=.*/JIDEO_GID=$(id -g)/" .env
    echo "→ .env créé"
  fi
  mkdir -p data
}

url() {
  local host port
  host=$(grep -E '^JIDEO_BIND=' .env 2>/dev/null | cut -d= -f2- || true)
  port=$(grep -E '^JIDEO_PORT=' .env 2>/dev/null | cut -d= -f2- || true)
  host="${host:-127.0.0.1}"
  [[ "$host" == "0.0.0.0" ]] && host="localhost"
  echo "http://${host}:${port:-4545}"
}

usage() {
  cat <<'EOT'
Usage : ./jideo <commande>
  install   crée .env, construit l'image, télécharge les modèles, démarre
  start     démarre Jideo
  stop      arrête Jideo
  restart   recrée le conteneur (relit .env, sert l'image à jour)
  status    état du conteneur
  logs      suit les journaux
  shell     shell dans le conteneur
  build     reconstruit l'image
  test      lance pytest dans le conteneur (arguments transmis à pytest)
  e2e       test de bout en bout (Jideo doit tourner, modèles installés)
EOT
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  install)
    command -v docker >/dev/null || die "Docker est requis"
    ensure_env
    compose build
    compose run --rm --no-deps jideo python -m app.engine.models download
    compose up -d
    echo "✓ Jideo tourne sur $(url)"
    ;;
  start)   ensure_env; compose up -d; echo "✓ Jideo tourne sur $(url)" ;;
  stop)    compose down ;;
  restart) ensure_env; compose up -d --force-recreate; echo "✓ Jideo tourne sur $(url)" ;;
  status)  compose ps ;;
  logs)    compose logs -f jideo ;;
  shell)   compose exec jideo bash ;;
  build)   ensure_env; compose build ;;
  test)    ensure_env; compose run --rm --no-deps jideo pytest "$@" ;;
  e2e)
    mkdir -p frontend/e2e/fixtures
    compose run --rm --no-deps -v "$PWD/frontend/e2e/fixtures:/out" jideo bash -c '
      python -c "import cv2; from insightface.data import get_image as g; cv2.imwrite(\"/out/source.png\", g(\"Tom_Hanks_54745\")); cv2.imwrite(\"/out/group.jpg\", g(\"t1\"))" &&
      ffmpeg -v error -y -loop 1 -i /out/group.jpg -f lavfi -i sine=frequency=440 -t 2 -r 10 \
        -vf scale=640:-2 -c:v libx264 -pix_fmt yuv420p -c:a aac -shortest /out/clip.mp4'
    (cd frontend && npx playwright install chromium && npx playwright test "$@")
    ;;
  help)    usage ;;
  *)       usage; exit 1 ;;
esac
